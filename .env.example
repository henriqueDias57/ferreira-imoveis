# Configuração do Banco de Dados
DATABASE_URL="file:./dev.db"

# Segredo de Assinatura de Sessão / JWT (Gerar uma chave aleatória com mínimo 32 caracteres)
JWT_SECRET="substitua_por_uma_chave_secreta_longa_e_aleatoria"

# Senha Inicial dos Administradores (usada apenas no seed)
ADMIN_INITIAL_PASSWORD="sua_senha_segura_aqui"
